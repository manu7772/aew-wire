{% extends '@AequationWire/admin/base_admin.html.twig' %}
{% import "@AequationWire/admin/partials/_elements.html.twig" as elements %}

{% block title %}SAdmin | Tailwind sandbox{% endblock %}

{% block main_content %}
<h1 class="text-3xl font-semibold mb-4">Tailwind sandbox</h1>
<div class="mt-12 flex flex-wrap gap-x-3 gap-y-1">
    {{ elements.ext_button("Tailwind detecting classes", "https://tailwindcss.com/docs/detecting-classes-in-source-files", "btn-outline btn-accent", "tabler:brand-tailwind") }}
    {{ elements.ext_button("Tailwind v4 content detection", "https://tailwindcss.com/blog/tailwindcss-v4#automatic-content-detection", "btn-outline btn-accent", "tabler:brand-tailwind") }}
    {{ elements.ext_button("Tailwind & DaisyUI", "https://www.youtube.com/watch?v=ky95s6eoNr4", "btn-outline btn-accent", "tabler:brand-youtube-filled") }}
    {{ elements.ext_button("Grafikart DaisyUI", "https://grafikart.fr/tutoriels/daisyui-tailwindcss-2285", "btn-outline btn-accent", "tabler:world-heart") }}
    {{ elements.ext_button("DaisyUI", "https://daisyui.com/?lang=fr", "btn-outline btn-accent", "tabler:world-heart") }}
</div>
<hr class="my-4 text-gray-700">
<div>
    
    <div class="my-4">
        {# {{ dump(tailwindBuilder|default(null)) }} #}
    </div>

</div>
{% endblock %}
