{% extends '@AequationWire/admin/base_admin.html.twig' %}
{% import "@AequationWire/admin/partials/_elements.html.twig" as elements %}

{% block title %}SAdmin | DTO sandbox{% endblock %}

{% block main_content %}
<h1 class="text-3xl font-semibold mb-4">DTO sandbox</h1>
<div class="mt-12 flex flex-wrap gap-x-3 gap-y-1">
    {{ elements.ext_button("Object mapper component", "https://symfony.com/doc/current/object_mapper.html", "btn-outline btn-accent", "tabler:brand-symfony") }}
    {{ elements.ext_button("Le composant ObjectMapper", "https://www.youtube.com/watch?v=hnqT4LqYfMM", "btn-outline btn-accent", "tabler:brand-youtube-filled") }}
</div>
<hr class="my-4 text-gray-700">
<div>
    
    {% if app.dev %}
    <div class="my-4">
        {{ dump(factory_classname|default(null)) }}
    </div>

    <div class="my-4">
        {{ dump(factory_data|default(null)) }}
    </div>

    <div class="my-4">
        {{ dump(factory_result|default(null)) }}
    </div>
    {% endif %}


</div>
{% endblock %}
