{% extends '@AequationWire/admin/base_admin.html.twig' %}

{% block title %}SAdmin | UUID sandbox{% endblock %}

{% block main_content %}
<h1 class="text-3xl font-semibold mb-4">UUID sandbox</h1>
<div class="mt-12 flex flex-wrap gap-x-3 gap-y-1">
    <a href="https://symfony.com/doc/current/components/uid.html" class="btn btn-primary m-0" target="_blank" rel="noopener noreferrer"><twig:ux:icon name="tabler:brand-symfony" class="w-6 h-6 inline-block" /> Symfony UUID Component</a>
</div>
<hr class="my-4 text-gray-700">
<div>
    
    <div class="my-4">
        {{ form(form) }}
    </div>

    <div class="my-4">
        {% for uuid in uuids|default([]) %}
        <div class="bg-white shadow-md rounded-lg p-4 mb-4">
            <div class="text-xl font-semibold text-gray-900 mb-2">UUID: {{ uuid }}</div>
            <div class="text-gray-700 mb-0.5">Valid: {% if uuid.isValid(uuid.toString()) %}<twig:ux:icon name="tabler:check" class="w-6 h-6 inline-block text-green-500" />{% else %}<twig:ux:icon name="tabler:x" class="w-6 h-6 inline-block text-red-500" />{% endif %}</div>
            {# <div class="text-gray-700 mb-0.5">Binary: {{ uuid.toBinary() }}</div> #}
            <div class="text-gray-700 mb-0.5">Hex: {{ uuid.toHex() }}</div>
            <div class="text-gray-700 mb-0.5">Base 58: {{ uuid.toBase58() }}</div>
            <div class="text-gray-700 mb-0.5">Base 32: {{ uuid.toBase32() }}</div>
            <div class="text-gray-700 mb-0.5">Date: {{ uuid.getDateTime()|format_datetime('medium', 'medium') }}</div>
        </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
