{% extends '@AequationWire/base_fullcentered.html.twig' %}

{% block title %}{{ title|default('SITE DE TEST')|trans }}{% endblock %}

{% block body %}
<div data-theme="dark" class="grid place-content-center h-screen pb-32">
    {% block outer_title_h1 %}
    <h1 class="text-center">{% block title_h1 %}{{ title|default('Ceci est un site de test') }}{% endblock %}</h1>
    {% endblock %}
    {% block page_content %}
    <div class="card w-128">
        {# <div class="text-center">Vous devez entrer un mot de passe pour accéder au contenu</div> #}
        <form action="{{ path(app.routeHome) }}" method="POST"{{ data_turbo(false) }}>
            <fieldset class="fieldset w-full bg-base-200 border-base-200 rounded-box border rounded-lg p-4">
                <legend class="fieldset-legend px-2">Accéder au site de test</legend>
                <div class="join mx-auto">
                    <input type="text" class="input join-item" name="demo_password" id="_demo_password" placeholder="Entrez le mot de passe ici" value={{ app.dev ? password|default("") : "" }} autocomplete="off" readonly onfocus="this.removeAttribute('readonly');" />
                    <button name="submit_password" id="_submit_password" class="btn join-item btn-info">Accéder</button>
                </div>
            </fieldset>
        </form>
    </div>
    {% if app.clientIp in grantedIps|default([]) %}
    <div class="card w-128 mt-4">
        <div class="text-center text-lime-400 italic"><strong>IP {{ app.clientIp }} reconnue</strong> : Mot de passe pour le site de test : <span>{{ password|default('???') }}</span></div>
    </div>
    <div class="card w-128 mt-4 hidden userlogged:block">
        <div class="text-center font-bold text-red-500">Vous êtes <u>connecté</u>, vous ne devriez pas vous retrouver sur cette page.<br>Contactez l'administrateur si cela vous pose un souci,<br>ou retournez à la page d'accueil.</span></div>
    </div>
    {% endif %}
    {% endblock %}
</div>
{% endblock %}