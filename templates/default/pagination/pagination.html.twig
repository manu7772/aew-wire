{# Sliding pagination control implementation #}
{% if pageCount > 1 %}
<nav aria-label="Page navigation" class="grid grid-flow-col justify-items-end">
    <div class="join select-none">
        {% if first is defined and current != first %}
        <a href="{{ path(route, knp_pagination_query(query, first)) }}" class="join-item btn">
            <twig:ux:icon name="tabler:player-track-prev-filled" class="w-5 h-5 inline-block" />
        </a>
        {% endif %}
        {% if previous is defined %}
        <a href="{{ path(route, knp_pagination_query(query, previous)) }}" class="join-item btn">
            <twig:ux:icon name="tabler:caret-left-filled" class="w-5 h-5 inline-block" />
        </a>        
        {% endif %}
        {% for page in pagesInRange %}
        <a href="{{ path(route, knp_pagination_query(query, page)) }}" class="join-item btn {{ page == current ? 'btn-disabled' }}">{{ page }}</a>
        {% endfor %}
        {% if next is defined %}
        <a href="{{ path(route, knp_pagination_query(query, next)) }}" class="join-item btn">
            <twig:ux:icon name="tabler:caret-right-filled" class="w-5 h-5 inline-block" />
        </a>
        {% endif %}
        {% if last is defined and current != last %}
        <a href="{{ path(route, knp_pagination_query(query, last)) }}" class="join-item btn">
            <twig:ux:icon name="tabler:player-track-next-filled" class="w-5 h-5 inline-block" />
        </a>
        {% endif %}
    </div>
</nav>

{% endif %}