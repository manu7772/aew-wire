{% if pageCount > 1 %}
    {% set justifys = ['justify-start','justify-between','justify-end'] %}
    {% set justify = 2 %}
    <div class="flex flex-row gap-1 items-center {{ justifys[justify] }} my-2">
        {% if previous is defined %}
            <a rel="prev" href="{{ path(route, knp_pagination_query(query, previous)) }}" class="flex items-center justify-center rounded-lg px-2 h-8 text-blue-500 bg-white border border-blue-300 hover:bg-blue-100 hover:text-blue-700 dark:bg-blue-800 dark:border-blue-700 dark:text-blue-400 dark:hover:bg-blue-700 dark:hover:text-white"><twig:ux:icon name="tabler:caret-left-filled" class="w-5 h-5 inline-block" /></a>
        {% else %}
            <span class="opacity-25 cursor-not-allowed flex items-center justify-center rounded-lg px-2 h-8 text-blue-500 bg-white border border-blue-300 dark:bg-blue-800 dark:border-blue-700 dark:text-blue-400"><twig:ux:icon name="tabler:caret-left-filled" class="w-5 h-5 inline-block" /></span>
        {% endif %}
        {% if next is defined %}
            <a rel="next" href="{{ path(route, knp_pagination_query(query, next)) }}" class="flex items-center justify-center rounded-lg px-2 h-8 text-blue-500 bg-white border border-blue-300 hover:bg-blue-100 hover:text-blue-700 dark:bg-blue-800 dark:border-blue-700 dark:text-blue-400 dark:hover:bg-blue-700 dark:hover:text-white"><twig:ux:icon name="tabler:caret-right-filled" class="w-5 h-5 inline-block" /></a>
        {% else %}
            <span class="opacity-25 cursor-not-allowed flex items-center justify-center rounded-lg px-2 h-8 text-blue-500 bg-white border border-blue-300 dark:bg-blue-800 dark:border-blue-700 dark:text-blue-400"><twig:ux:icon name="tabler:caret-right-filled" class="w-5 h-5 inline-block" /></span>
        {% endif %}
    </div>
{% endif %}