{% if pageCount > 1 %}
<div class="grid grid-flow-col justify-items-end">
    <div class="join select-none">
        <a{% if previous is defined %} href="{{ path(route, knp_pagination_query(query, previous)) }}"{% endif %} class="join-item btn {{ previous is defined ? '' : 'btn-disabled' }}">
            <twig:ux:icon name="tabler:caret-left-filled" class="w-5 h-5 inline-block" />
        </a>
        <a{% if next is defined %} href="{{ path(route, knp_pagination_query(query, next)) }}"{% endif %} class="join-item btn {{ next is defined ? '' : 'btn-disabled' }}">
            <twig:ux:icon name="tabler:caret-right-filled" class="w-5 h-5 inline-block" />
        </a>
    </div>
</div>
{% endif %}