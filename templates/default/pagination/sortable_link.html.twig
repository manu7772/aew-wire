<a{% for attr, value in options %} {{ attr }}="{{ value }}"{% endfor %}>
    <div class="flex flex-row gap-1">
        <div>{{ title }}</div>
        {% if sorted %}
        {{ ux_icon(direction == 'desc' ? 'tabler:chevron-down' : 'tabler:chevron-up', {class: "w-5 h-5 inline-block"}) }}
        {% else %}
        {{ ux_icon(direction == 'desc' ? 'tabler:chevron-down' : 'tabler:chevron-up', {class: "w-5 h-5 inline-block opacity-50"}) }}
        {% endif %}
    </div>
</a>
