{% macro table(entities, fields, options) %}
    {% import '@AequationWire/admin/partials/_elements.html.twig' as elements %}
    {% import _self as self %}
    {% set paginated = entities|shortname in ['SlidingPagination'] %}
    {% set trans_domain = options.trans_domain|default(options.shortname) %}

    <div class="flex flex-row gap-2 flex-wrap justify-between items-start mb-2">
        <h2>{{ options.title|default(null) is not empty ? options.title|trans|raw : 'actions.count'|trans({'%count%': paginated ? entities.getTotalItemCount : entities|length}, trans_domain) }}</h2>
        {% if options.actions|default(false) or options.top_buttons is defined %}
        <div class="h-full flex flex-row gap-1 items-center">
            {{ options.top_buttons is defined ? self.include_template(options.top_buttons, {entities: entities, trans_domain: trans_domain, options: options}, 'top_buttons_' ~ options.shortname|lower ~ '_index') }}
            {{ options.actions|default(false) ? elements.button('new', options.shortname) }}
        </div>
        {% endif %}
    </div>

    {% if paginated %}
    <div class="mt-2 w-full text-right">
        {{ knp_pagination_rel_links(entities) }}
    </div>
    {% endif %}
    <table class="table table-zebra">
        <thead>
            <tr>
                {% for field_name,field in fields %}
                {% set name = field.label|default('fields.' ~ field_name)|trans({}, trans_domain) %}
                {% if name == 'fields.' ~ field_name %}
                {% set name = field_name %}
                {% endif %}
                <th class="whitespace-nowrap align-top">
                    <div class="{{ field.classes is defined ? field.classes|join(' ') }}">
                        {{ paginated and field.sortable|default(false) ? knp_pagination_sortable(entities, name, [options.alias, field_name]|join('.')) : name }}
                    </div>
                </th>
                {% if loop.first and options.actions|default(false) -%}
                <th class="whitespace-nowrap align-top">{{ 'actions.actions'|trans({}, trans_domain) }}</th>
                {%- endif %}
                {% endfor %}
            </tr>
        </thead>
        <tbody>
        {% for entity in entities %}
            <tr class="hover:bg-base-300 cursor-default{{ entity.active|default(true) ? '' : ' opacity-50 italic' }}">
                {% for field_name,field in fields %}
                <td class="align-top">
                    <div class="{{ field.classes is defined ? field.classes|join(' ') }}">
                        {{ field.view_options.template_before is defined ? self.include_template(field.view_options.template_before, {entities: entities, entity: entity, trans_domain: trans_domain, field: field, options: options}, 'template_before_' ~ options.shortname|lower ~ '_index') }}
                        {{ field_value(entity, field_name, trans_domain, field.view_options|default([])) }}
                        {{ field.view_options.template_after is defined ? self.include_template(field.view_options.template_after, {entities: entities, entity: entity, trans_domain: trans_domain, field: field, options: options}, 'template_after_' ~ options.shortname|lower ~ '_index') }}
                        {% if loop.first and entity.prefered is defined and entity.prefered %}
                        <span title="{{ 'fields.prefered'|trans({}, trans_domain) }}"><twig:ux:icon name="tabler:star-filled" class="w-4 h-4 inline-block ml-1" /></span>
                        {% endif %}
                    </div>
                </td>
                {% if loop.first and options.actions|default(false) %}
                <td class="w-1 align-top">
                    <div class="flex flex-row justify-center gap-2">
                        {{ elements.button('show', entity, {class: '', icon_class: 'w-5 h-5 inline-block hover:text-blue-400'}) }}
                        {{ elements.button('edit', entity, {class: '', icon_class: 'w-5 h-5 inline-block hover:text-blue-400'}) }}
                        {{ elements.button('delete', entity, {class: '', icon_class: 'w-5 h-5 inline-block hover:text-red-600'}) }}
                    </div>
                </td>
                {% endif %}
                {% endfor %}
            </tr>
        {% else %}
            <tr>
                <td class="align-top" colspan="100%">{{ 'actions.count'|trans({'%count%': entities|length}, trans_domain) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if paginated %}
    <div class="mt-2 w-full justify-end">
        {# {{ knp_pagination_rel_links(entities) }} #}
        {{ knp_pagination_render(entities) }}
    </div>
    {% endif %}
    {# <hr class="my-2">
    {{ dump(entities) }}#}
{% endmacro %}

{% macro include_template(template, data, name = null) %}
    {% if template.path is defined %}
    {{ include(template.path, data) }}
    {% elseif template.from_string is defined %}
    {# @see https://twig.symfony.com/doc/3.x/functions/template_from_string.html #}
    {{ template_from_string(template.from_string, name) }}
    {% endif %}
{% endmacro %}

{% macro classStates(wCmd) %}
    <div class="inline-block"><twig:ux:icon name="{{ wCmd.instantiable ? 'tabler:database' : 'tabler:ghost-3'}}" class="w-4 h-4 inline {{ wCmd.instantiable ? 'text-lime-500' : 'text-gray-500' }}" /></div>
    <div class="inline-block"><twig:ux:icon name="{{ wCmd.managed ? 'tabler:database-plus' : 'tabler:database-x'}}" class="w-4 h-4 inline {{ wCmd.managed ? 'text-lime-400' : 'text-gray-500' }}" /></div>
    <div class="inline-block"><twig:ux:icon name="{{ wCmd.final ? 'tabler:database-star' : 'tabler:database-x'}}" class="w-4 h-4 inline {{ wCmd.final ? 'text-lime-200' : 'text-gray-500' }}" /></div>
    <div class="inline-block {{ wCmd.abstract ? 'font-light italic text-gray-400' : ''}}">
        {{ wCmd.shortname }}
    </div>
{% endmacro %}