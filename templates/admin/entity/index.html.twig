{% extends '@AequationWire/admin/base_admin.html.twig' %}
{% import '@AequationWire/admin/partials/_elements.html.twig' as elements %}
{% import '@AequationWire/admin/partials/_print.html.twig' as print %}
{% trans_default_domain options.trans_domain %}

{% set paginated = entities|shortname in ['SlidingPagination'] %}
{% block title %}
	{{ options.title|default(null) is not empty ? options.title|trans|striptags : 'actions.count'|trans({'%count%': paginated ? entities.getTotalItemCount : entities|length}) }}
{% endblock %}

{% block main_content %}

	{% block headtitle %}
    <div class="flex flex-row gap-2 flex-wrap justify-between items-start mb-2">
        <h1 class="font-bold text-info text-2xl">{{ 'names'|trans|capitalize }}</h1>
		{# {% if options.actions|default(false) %}
        <div class="h-full flex flex-row gap-1 items-center">
            {{ elements.button('new', options.trans_domain, { text: true }) }}
        </div>
		{% endif %} #}
    </div>
	{% endblock %}

	{% block entitydata %}
	{# {{ print.table(entities, fields, options|merge({actions: false})) }} #}
	{{ print.table(entities, fields, options) }}
	{% endblock %}

{% endblock %}
