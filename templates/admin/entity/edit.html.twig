{% extends '@AequationWire/admin/base_admin.html.twig' %}
{% trans_default_domain entity.trans_domain %}

{% block title %}{{ 'actions.edit'|trans }} {{ entity }}{% endblock %}

{% block main_content %}

    {% block headtitle %}
    <div class="flex flex-row gap-2 flex-wrap justify-between items-start mb-2">
        <h1 class="font-bold text-info text-2xl"><span class="text-lg font-light">{{ 'actions.edit'|trans }}</span> {{ entity }}</h1>
        <div class="h-full flex flex-row gap-1 items-center">
            <twig:wire:button action="show" :entity="entity"></twig:wire:button>
            <twig:wire:button action="index" :entity="entity.shortname"></twig:wire:button>
        </div>
    </div>
    {% endblock %}

    {% block entitydata %}
    <twig:wire:entity-form :entity="entity"/>
    {% endblock %}

{% endblock %}
