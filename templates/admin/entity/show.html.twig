{% extends '@AequationWire/admin/base_admin.html.twig' %}
{% trans_default_domain entity.trans_domain %}

{% block title %}{{ 'name'|trans }} {{ entity }}{% endblock %}

{% block main_content %}
    {% if not entity %}

    {% block empty_data %}
    <twig:wire:alert type="warning" icon="tabler:info-circle">{{ 'not_found'|trans }}</twig:wire:alert>
    {% endblock %}

    {% else %}

    {% block headtitle %}
    <div class="flex flex-row gap-2 flex-wrap justify-between items-start mb-2">
        <h1 class="font-bold text-accent text-2xl"><twig:ux:icon name="{{ entity.icon('ux') }}" class="w-8 inline pr-1" />{{ entity }}</h1>
        <div class="h-full flex flex-row gap-1 items-center">
            <twig:wire:button action="index" :entity="entity.shortname"></twig:wire:button>
            <twig:wire:button action="delete" :entity="entity"></twig:wire:button>
            <twig:wire:button action="edit" :entity="entity"></twig:wire:button>
        </div>
    </div>
    {% endblock %}
    {% block entitydata %}
    <twig:wire:table-entity :entity="entity" :debug="app.devOrSadmin" />
    {% endblock %}
    {% endif %}
{% endblock %}
