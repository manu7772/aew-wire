{% extends '@AequationWire/admin/entity/show.html.twig' %}
{% trans_default_domain entity.trans_domain %}

{% block entitydata %}
<div class="border rounded-lg shadow-lg px-6 py-8 max-w-4xl mx-auto mt-8">
    <div class="text-sm italic font-thin text-center">{{ 'name'|trans }}</div>
    <h1 class="font-bold text-2xl mb-4 text-center">{{ entity.name }}</h1>
    <hr class="mb-2">
    <div class="flex justify-between items-start mb-6">
        <div class="flex gap-1 flex-wrap">
            {% if entity.active %}
            <div class="badge badge-success">{{ 'fields.active'|trans }}</div>
            {% else %}
            <div class=" badge-warning">{{ 'fields.inactive'|trans }}</div>
            {% endif %}
            {% if entity.prefered %}
            <div class=" badge-success"><twig:ux:icon name="tabler:star-filled" class="w-3 h-3 inline-block mr-1" />{{ 'fields.prefered'|trans }}</div>
            {% endif %}
        </div>
        <div>
            {# @see https://twig.symfony.com/doc/3.x/filters/format_datetime.html #}
            <div>{{ 'fields.createdAt'|trans }} : <span class="font-bold">{{ entity.createdAt|format_datetime('medium', 'medium') }}</span></div>
            {% if entity.updatedAt %}
            <div>{{ 'fields.updatedAt'|trans }} : <span class="font-bold">{{ entity.updatedAt|format_datetime('medium', 'medium') }}</span></div>
            {% else %}
            <div>{{ 'not_updated' }}</div>
            {% endif %}
            <div>{{ 'fields.timezone'|trans }} : <span class="font-bold">{{ entity.timezone }}</span></div>
        </div>
    </div>
    <div class="mb-8">
        <h2 class="text-lg font-bold mb-2">{{ 'fields.categories'|trans }}</h2>
        {% if entity.categorys.empty %}
        <twig:ux:icon name="tabler:x" class="w-6 h-6 inline-block" />
        {% else %}
        <ul class="w-full text-sm font-medium rounded-lg border">
            {% for category in entity.categorys %}
            <li class="w-full px-4 py-2 border-b">{{ category.name }}</li>
            {% endfor %}
        </ul>
        {% endif %}
    </div>
    <div class="mb-8">
        <h2 class="text-lg font-bold mb-2">{{ 'fields.associates'|trans }}</h2>
        <div class="flex flex-row gap-2 flex-wrap">
            {% if entity.associates.empty %}
            <twig:ux:icon name="tabler:x" class="w-6 h-6 inline-block" />
            {% else %}
            {% for user in entity.associates %}
            <span class="badge badge-primary">{{ user.name }}</span>
            {% endfor %}
            {% endif %}
        </div>
    </div>
    <table class="w-full mb-8">
        <thead>
            <tr>
                <th class="border border-gray-500 px-2 py-1 text-left font-bold">Attribut</th>
                <th class="border border-gray-500 px-2 py-1 text-center font-bold">Valeur</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="border border-gray-500 px-2 py-1 text-left">{{ 'fields.annuaire_view'|trans }}</td>
                <td class="border border-gray-500 px-2 py-1 text-center">{{ (entity.annuaire|json_encode)|trans([], 'messages') }}</td>
            </tr>
        </tbody>
    </table>
    {# <div class="mb-2">Thank you for your business!</div> #}
    {# <div class="text-sm">Please remit payment within 30 days.</div> #}
    {% if app.dev %}
    <div class="mb-8">
        <h2 class="text-lg font-bold mb-2 text-sky-800">Dump entity</h2>
        <div class="flex flex-row gap-2 flex-wrap">
            {{ dump(entity) }}
        </div>
    </div>
    {% endif %}
</div>
{% endblock %}
