{% extends '@AequationWire/admin/base_admin.html.twig' %}
{% trans_default_domain model.trans_domain %}

{% block title %}{{ 'actions.new'|trans }}{% endblock %}

{% block main_content %}

    {% block headtitle %}
    <div class="flex flex-row gap-2 flex-wrap justify-between items-start mb-2">
        <h1 class="font-bold text-accent text-2xl">{{ 'actions.new'|trans }}</h1>
        <div class="h-full flex flex-row gap-1 items-center">
            <twig:wire:button action="index" :entity="model.shortname" icon="tabler:x" size="sm">{{ 'Cancel'|trans([], 'messages') }}</twig:wire:button>
        </div>
    </div>
    {% endblock %}

    {% block entitydata %}
    <twig:wire:entity-form :baseEntity="entity"/>
    {% endblock %}

{% endblock %}
