<div{{ attributes }}>

    {% if registeredMessage %}
    <twig:wire:alert type="success" class="mb-2">{{ registeredMessage }}</twig:wire:alert>
    {% endif %}

    {% if errorMessage %}
    <twig:wire:alert type="danger" class="mb-2">{{ errorMessage }}</twig:wire:alert>
    {% endif %}

    {{ form(form) }}

</div>