
<div{{ attributes }}>

    {% macro level(item, class = null) %}
        {% import _self as self %}
        <li class="rounded-box {{ item.open ? ' bg-accent/30' }}">
            {% if item.empty %}
            <a href="{{ item.url }}">{% if item.icon|default(false) %}<twig:ux:icon name="{{ item.icon }}" class="size-4"/>{% endif %}{{ item.title }}</a>
            {% else %}
            <details{{ item.open ? ' open' : '' }}>
                <summary>{% if item.icon|default(false) %}<twig:ux:icon name="{{ item.icon }}" class="size-4"/>{% endif %}{{ item.title }}</summary>
                <ul>
                    {% for item_next in item %}
                    {{ self.level(item_next) }}
                    {% endfor %}
                </ul>
            </details>
            {% endif %}
        </li>
    {% endmacro %}
    
    {# @see https://daisyui.com/components/menu/#collapsible-submenu #}
    {% import _self as self %}

    {% if computed.elements.count > 0 %}
    {# <h2>{{ computed.elements.title }}</h2> #}
    <ul class="menu rounded-box w-full">
        {% for item_L1 in computed.elements %}
        {{ self.level(item_L1) }}
        {% endfor %}
    </ul>
    {% endif %}
        
</div>