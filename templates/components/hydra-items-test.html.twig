<div{{ attributes }}{{ data_turbo(false) }} class="mt-3">
    {% if item is defined %}
    <li class="list-row border border-gray-600">
        <div>
            {% if icon %}
            <twig:ux:icon name="{{ getIcon(item.classname|default('')) }}" class="grow-0 size-5 {{ item.errors is empty ? 'text-success' : 'text-error' }}"/>
            {% else %}
            <div aria-label="{{ item.errors is empty ? 'success' : 'error' }}" class="grow-0 status {{ item.errors is empty ? 'text-success' : 'text-error' }} h-3 w-3"></div>
            {% endif %}
        </div>
        <div>
            <div>{{ item.classname|default('Entité inconnue') }}<span class="italic opacity-50">[{{ item.item_index }}]</span> <twig:ux:icon name="tabler:arrow-narrow-right" class="size-5 inline" /> <span class="font-bold">{{ item.entity.__toString() }}</span></div>
            <div class="mt-1 mb-2">
                {% if item.errors is not empty %}
                <div class="text-error"><twig:ux:icon name="tabler:x" class="size-5 inline" /> Hydrated entity is <span class="font-bold">invalid</span></div>
                {% else %}
                <div class="text-success"><twig:ux:icon name="tabler:check" class="size-5 inline" /> Hydrated entity is <span class="font-bold">valid</span></div>
                {% endif %}
            </div>
            <div class="mt-4 rounded-lg overflow-hidden">
                <twig:wire:hydra-entity :entity="item.entity" :hydraItem="item.data" :errors="item.errors|default([])" />
            </div>
        </div>
        <div class="flex flex-col xl:flex-row gap-1">
            <a href="{{ path('hydration_generate', {data: item.json_item_index}) }}" class="btn btn-square btn-soft {{ item.errors is empty ? 'btn-success' : 'btn-error'}}" title="Generate">
                <twig:ux:icon name="tabler:player-play-filled" class="size-[1.2em]"/>
            </a>
            <a href="{{ path('hydration_test', {data: item.json_item_index}) }}" class="btn btn-square btn-soft {{ item.errors is empty ? 'btn-success' : 'btn-error'}}" title="Test">
                <twig:ux:icon name="tabler:player-play" class="size-[1.2em]"/>
            </a>
            <a href="{{ path('hydration_show', {name: item.classname|shortname}) }}" class="btn btn-square btn-soft {{ item.errors is empty ? 'btn-success' : 'btn-error'}}" title="View">
                <twig:ux:icon name="tabler:eye" class="size-[1.2em]"/>
            </a>
        </div>
    </li>
    {% else %}
    <twig:wire:alert type="error">Aucune donnée de type test n'a été trouvée. Veuillez vérifier votre configuration ou créer des données d'hydratation.</twig:wire:alert>
    {% endif %}
</div>