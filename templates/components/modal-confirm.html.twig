{% set text %}{% block content %}{% endblock %}{% endset %}
<div{{ attributes }}>
    <div id="{{ id }}" tabindex="-1" data-modal-options="{{ {placement: 'top-center'}|json_encode }}" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
        <div class="relative p-4 w-full max-w-md max-h-full">
            <div class="relative bg-base-100 rounded-lg shadow-sm">
                <button type="button" class="absolute top-3 end-2.5 bg-transparent opacity-60 hover:opacity-100" data-modal-hide="{{ id }}">
                    <twig:ux:icon name="tabler:x" class="size-6" />
                    <span class="sr-only">{{ 'Close'|trans }}</span>
                </button>
                <div class="p-4 md:p-5 text-center">
                    <twig:ux:icon name="{{ icon|default('tabler:question-mark') }}" class="mx-auto mb-4 size-12" />
                    {% if title|has_text and title != text %}
                    <h2 class="font-bold text-xl mb-2">{{ title|raw }}</h2>
                    {% endif %}
                    <div class="mb-5 text-lg font-bold">{{ text|raw }}</div>
                    <button data-modal-hide="{{ id }}" type="button" class="btn btn-neutral btn-dash">{{ 'non'|trans }}</button>
                    <button data-modal-hide="{{ id }}" data-modal-confirm-trigger type="button" class="btn btn-error">{{ 'Oui'|trans }}</button>
                </div>
            </div>
        </div>
    </div>
</div>