{% set text %}{% block content %}{% endblock %}{% endset %}
<div{{ attributes }}>
    <div id="{{ id }}" tabindex="-1" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
        <div class="relative p-4 w-full max-w-md max-h-full">
            <div class="relative rounded-lg shadow-2xl shadow-black border-2 border-error">
                <button type="button" class="absolute top-3 end-2.5 rounded-lg text-sm size-8 ms-auto inline-flex justify-center items-center" data-modal-hide="{{ id }}">
                    <twig:ux:icon name="tabler:x" class="size-8" />
                    <span class="sr-only">{{ 'close'|trans }}</span>
                </button>
                <div class="p-4 md:p-5 text-center">
                    <twig:ux:icon name="{{ icon|default('tabler:question-mark') }}" class="mx-auto mb-4 size-12" />
                    {% if title|has_text and title != text %}
                    <h2 class="font-bold text-xl text-accent mb-2 opacity-75">{{ title|raw }}</h2>
                    {% endif %}
                    <h3 class="mb-5 text-lg font-bold">{{ text|raw }}</h3>
                    <button data-modal-hide="{{ id }}" data-modal-confirm-trigger type="button" class="btn btn-error">{{ 'Oui'|trans }}</button>
                    <button data-modal-hide="{{ id }}" type="button" class="btn btn-secondary">{{ 'non'|trans }}</button>
                </div>
            </div>
        </div>
    </div>
</div>