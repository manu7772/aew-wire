{% extends '@AequationWire/admin/base_admin.html.twig' %}

{% block title %}Hydration test{% endblock %}

{% block main_content %}
	{% if not app.devOrSadmin %}
		{{ include('@AequationWire/admin/partials/_forbidden.html.twig', {}, true) }}
	{% else %}
		<h1 class="text-3xl font-semibold mb-4">
            <a href="{{ links.valid ? path('hydration_index') : app.request.headers.get('referer') }}" class="btn btn-square btn-ghost btn-outline mr-2">
                <twig:ux:icon name="tabler:chevron-left" class="size-[1.2em]"/>
            </a>
			<twig:ux:icon name="tabler:database-plus" class="w-8 h-8 inline mr-2"/>
			Hydration <span class="text-accent">test</span>
		</h1>

		{% if links.total > 1 %}
		<div class="divider my-6">
			<a href="{{ path('hydration_generate', {data: links.valids|json_encode}) }}" class="btn btn-soft btn-success" title="{{ links.valid ? 'Generate all' : 'Generate valids'}} ({{ links.total }})">
				{{ links.valid ? 'Tout générer' : 'Générer valides' }} ({{ links.total }}) <twig:ux:icon name="tabler:player-track-next-filled" class="size-[1.4em]"/>
			</a>
			<a href="{{ path('hydration_test', {data: links.valids|json_encode}) }}" class="btn btn-soft btn-success" title="{{ links.valid ? 'Test all' : 'Test valids'}} ({{ links.total }})">
				{{ links.valid ? 'Tout tester' : 'Tester valides' }} ({{ links.total }}) <twig:ux:icon name="tabler:player-track-next" class="size-[1.4em]"/>
			</a>
		</div>
		{% endif %}

		{% for opresult in opresults %}
		{% set current_index = (opresult.data|first).index %}
		{% set badge_color = links.total_invalids <= 0 ? 'badge-success' : (links.total_valids > 0 ? 'badge-warning' : 'badge-error') %}
		{% set border_color = links.total_invalids <= 0 ? 'border-success' : (links.total_valids > 0 ? 'border-warning' : 'border-error') %}
		<div class="px-4 pb-3 pt-1 border {{ border_color }} rounded-lg my-2">
			{# <div class="mt-4 mb-2">
				<twig:wire:alert type="{{ opresult.cssColor }}" icon="{{ true }}">
					{% if opresult.isSuccess %}
						Toutes les entités testées ont été hydratées avec succès.
					{% elseif opresult.isPartialSuccess %}
						Certaines entités testées n'ont pas pu être hydratées complètement.
					{% elseif opresult.isFail %}
						Aucune entité testée n'a pu être hydratée.
					{% else %}
						Erreurs lors de l'hydratation des entités.
					{% endif %}
				</twig:wire:alert>
			</div> #}
			<div class="mt-1">
				<span class="badge {{ badge_color }} font-bold select-none">{{ links.counts[current_index] }} entité(s) testée(s)</span>
				<span class="badge {{ links.valids[current_index]|length > 0 ? 'badge-success' : 'text-base-content/60' }} font-bold select-none">{{ links.valids[current_index]|length }} entité(s) valide(s)</span>
				<span class="badge {{ links.invalids[current_index]|length > 0 ? 'badge-error' : 'text-base-content/60' }} font-bold select-none">{{ links.invalids[current_index]|length }} entité(s) invalide(s)</span>
			</div>
			{% if opresult.data is empty %}
			<div role="alert" class="alert alert-warning">
				<twig:ux:icon name="tabler:database-exclamation" class="h-6 w-6 shrink-0 stroke-current"/>
				<span>Aucune donnée disponible</span>
			</div>
			{% else %}
			<ul class="list rounded-box shadow-md mt-0">
				{% for item in opresult.data %}
				<twig:wire:hydra-items-test item="{{ item }}" icon="{{ true }}" />
				{% endfor %}
			</ul>
			{% endif %}
		</div>
		{% endfor %}

	{% endif %}
{% endblock %}
