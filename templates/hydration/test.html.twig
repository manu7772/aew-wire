{% extends '@AequationWire/admin/base_admin.html.twig' %}

{% block title %}Hydration
{% endblock %}

{% block main_content %}
	{% if not app.devOrSadmin %}
		{{ include('@AequationWire/admin/partials/_forbidden.html.twig', {}, true) }}
	{% else %}
		<h1><twig:ux:icon name="tabler:database-plus" class="w-8 h-8 inline mr-2"/>Hydration</h1>
		<div class="mb-4 text-sm text-base-content font-light">
			<p>Hydration is the process of converting data from a format suitable for storage or transmission into a format suitable for use in your application.</p>
			<p>This page allows you to view and manipulate the hydration process for various entities.</p>
			<p>Ensure your
				<span class="font-semibold">hydratable entities</span>
				are properly configured to work with the hydration process and they implement the
				<span class="font-semibold">Aequation\WireBundle\Interface\WireHydratable</span>
				interface.</p>
			{% set indexes = hydradataItems.validIndexes|default([]) %}
			{% if indexes|length %}
			<div class="divider my-6">
				<a href="{{ path('hydration_generate', {index: indexes|json_encode}) }}" class="btn btn-soft btn-success" title="Generate all {{ indexes|length }}">
					Tout générer ({{ indexes|length }}) <twig:ux:icon name="tabler:player-track-next-filled" class="size-[1.4em]"/>
				</a>
				<a href="{{ path('hydration_test', {index: indexes|json_encode}) }}" class="btn btn-soft btn-success" title="Test all {{ indexes|length }}">
					Tout générer ({{ indexes|length }}) <twig:ux:icon name="tabler:player-track-next" class="size-[1.4em]"/>
				</a>
			</div>
			{% endif %}
		</div>

		{% if hydradataItems.empty %}
		<div role="alert" class="alert alert-warning">
			<twig:ux:icon name="tabler:database-exclamation" class="h-6 w-6 shrink-0 stroke-current"/>
			<span>Aucune donnée disponible</span>
		</div>
		{% else %}
		{% import "@AequationWire/hydration/partials/_elements.html.twig" as elements %}
		<ul class="list bg-base-100 rounded-box shadow-md">
			<li class="p-4 pb-2 text-sm opacity-60 tracking-wide">Liste des entités à générer : {{ hydradataItems.count }}</li>
			{% for items in hydradataItems %}
			{{ elements.renderItem(items) }}
			{% endfor %}
		</ul>
		{% endif %}

		{# {{ dump(hydradataItems) }} #}

	{% endif %}
{% endblock %}
