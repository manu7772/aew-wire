{
    "name": "aequation/wire",
    "type": "symfony-bundle",
    "description": "This bundle is my symfony common base projects.",
    "keywords": [ "symfony","symfony-bundle","symfony-ux" ],
    "homepage": "https://www.aequation.fr",
    "license": "MIT",
    "authors": [
        {
            "name": "Emmanuel Dujardin / Aequation",
            "homepage": "https://github.com/manu7772"
        }
    ],
    "autoload": {
        "psr-4": {
            "Aequation\\WireBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Aequation\\WireBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "symfony/config": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/stimulus-bundle": "^2.32",
        "symfony/http-kernel": "^8.0",
        "symfony/expression-language": "^8.0",
        "symfony/filesystem": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/string": "^8.0",
        "symfony/yaml": "^8.0",
        "symfony/http-client": "^8.0",
        "symfony/asset-mapper": "^8.0",
        "symfony/asset": "^8.0",
        "symfony/twig-pack": "^1.0",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.6",
        "symfony/serializer": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/flex": "^2.10",
        "symfony/security-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/form": "^8.0",
        "twig/twig": "^3.22",
        "twig/extra-bundle": "^3.22",
        "symfony/translation": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfonycasts/verify-email-bundle": "^1.18",
        "symfonycasts/dynamic-forms": "^0.2.0",
        "symfony/ux-twig-component": "^2.32",
        "symfony/ux-live-component": "^2.32",
        "symfony/ux-icons": "^2.32",
        "symfony/ux-turbo": "^2.32",
        "symfony/ux-leaflet-map": "^2.32",
        "liip/imagine-bundle": "^2.17",
        "vich/uploader-bundle": "^2.9",
        "symfonycasts/tailwind-bundle": "^0.12.0",
        "symfony/uid": "^8.0",
        "symfony/rate-limiter": "^8.0",
        "stof/doctrine-extensions-bundle": "^1.15",
        "knplabs/knp-paginator-bundle": "^6.10",
        "nucleos/dompdf-bundle": "^4.5",
        "symfonycasts/reset-password-bundle": "^1.24",
        "symfony/mailer": "^8.0",
        "twig/string-extra": "^3.22",
        "twig/intl-extra": "^3.22",
        "symfony/object-mapper": "^8.0",
        "symfony/apache-pack": "^1.0",
        "tales-from-a-dev/twig-tailwind-extra": "^1.0"
    },
    "conflict": {
        "symfony/flex": "<1.13"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": false,
            "symfony/runtime": false
        }
    },
    "extra": {
        "thanks": {
            "name": "symfony/ux",
            "url": "https://github.com/symfony/ux"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "symfony/debug": "^4.4",
        "symfony/framework-bundle": "^8.0",
        "symfony/phpunit-bridge": "^8.0",
        "symfony/twig-bundle": "^8.0",
        "symfony/var-dumper": "^8.0",
        "symfony/stopwatch": "^8.0",
        "symfony/maker-bundle": "^1.65"
    }
}
