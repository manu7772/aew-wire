{
    "name": "@aequation/wire",
    "description": "Utilities integration for Symfony",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "symfony-ux"
    ],
    "type": "module",
    "symfony": {
        "controllers": {
            "globalapp": {
                "main": "dist/globalapp_controller.js",
                "fetch": "eager",
                "enabled": true,
                "autoimport": {
                    "flowbite/dist/flowbite.min.css": false
                }
            },
            "scrollup": {
                "main": "dist/scrollup_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "sortable": {
                "main": "dist/sortable_controller.js",
                "fetch": "lazy",
                "enabled": true
            },
            "toastr": {
                "main": "dist/toastr_controller.js",
                "fetch": "lazy",
                "enabled": true,
                "autoimport": {
                    "toastr/build/toastr.min.css": true
                }
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.2.2",
            "flowbite": "^3.1.2",
            "sortablejs": "^1.15.6",
            "toastr": "^2.1.4",
            "browser": "^0.2.6",
            "daisyui": "^5.1.12",
        "daisyui/theme": "^5.1.12"
        },
        "entrypoints": {
            "@aequation/wire": "./vendor/aequation/wire/assets/wireadmin.js"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.2.2",
        "flowbite": "^3.1.2",
        "sortablejs": "^1.15.6",
        "toastr": "^2.1.4",
        "browser": "^0.2.6",
        "daisyui": "^5.1.12",
        "daisyui/theme": "^5.1.12"
    },
    "DevDependencies": {
        "@hotwired/stimulus": "^3.2.2",
        "flowbite": "^3.1.2",
        "sortablejs": "^1.15.6",
        "toastr": "^2.1.4",
        "browser": "^0.2.6",
        "daisyui": "^5.1.12",
        "daisyui/theme": "^5.1.12"
    }
}
